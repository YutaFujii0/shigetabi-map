---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import MiniMap from '../components/MiniMap.astro';
import VideoItem from '../components/VideoItem.astro';
import Thumb from '../components/Thumb.astro';
import Title from '../components/Title.astro';
import Flag from '../components/Flag.astro';
import { bbox, W, H } from '../lib/geo';
import {
  allSeries, visited, latestVideo, recentStops, currentPos, site,
  countryName, videosByCountry, lastStopIn, seriesOfCountry, seriesSummary, seriesPeriod, getSeries, ym, ymd, youtubeUrl,
  visitedCountryCount, visitedList, videos, seriesColor, travelSeries, worldcupSeries, japanSeries, seasonOf, JAPAN,
} from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const seriesUrl = (id: string, iso?: string) => `${base}/series/${id}/${iso ? `#c-${iso}` : ''}`;
// 最新の動画のサムネイル（ページで一番大きく表示される画像）は先読みする
const latestThumb = latestVideo.thumbnail ?? (latestVideo.video_id.startsWith('sample') ? undefined : `https://i.ytimg.com/vi/${latestVideo.video_id}/mqdefault.jpg`);
const latestSeries = latestVideo.series_id ? getSeries(latestVideo.series_id) : null;
const latestNames = latestVideo.countries.map(countryName).join('・');
const fitNarrow = bbox(currentPos ? [...recentStops, currentPos] : recentStops, 60);
const visitedIsos = [...visited].filter((iso) => iso !== JAPAN);
const japanVideoCount = japanSeries.reduce((n, x) => n + seriesSummary(x).videoCount, 0);
const seriesNames = travelSeries.map((x) => x.name).join('・') + (worldcupSeries.length ? `、ワールドカップ編（${worldcupSeries.map((x) => x.name.replace(/編$/, '')).join('・')}）` : '') + (japanSeries.length ? '、日本国内編' : '');
const description = `旅系YouTuber「しげ旅（シゲタビ）」の旅のルートと訪問国リスト（${visitedCountryCount}か国）、${seriesNames}の全${allSeries.length}シリーズ・全${videos.length}本の動画リストを世界地図でまとめた非公式ファンサイト。国をクリックするとその国の動画リストが見られます。`;
const site_url = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'しげ旅ルートマップ', alternateName: ['しげ旅 ルート', 'しげ旅 リスト', 'しげ旅 訪問国リスト', 'シゲタビ ルート'], url: site_url, inLanguage: 'ja', description },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'しげ旅のシリーズとルート',
    itemListElement: allSeries.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: `しげ旅 ${x.name}`, url: new URL(`series/${x.id}/`, site_url).href })),
  },
];
---
<Base home description={description} jsonLd={jsonLd} preloadImage={latestThumb}>
  <div class="main">
    <WorldMap id="homemap" route={recentStops} routeLabel="直近5か国のルート" marker fillWidth fit={{ x: 0, y: 0, w: W, h: H }} fitNarrow={fitNarrow}>
      <!-- スマホ：国をタップしても自動ではスクロールせず、この案内から動画一覧へ移る -->
      <button type="button" class="pickchip" hidden></button>
    </WorldMap>

    <div class="side">
    <aside class="panel" id="panel" aria-live="polite">
      <!-- 初期表示：最新の動画1本。現在地とは混ぜない -->
      <div data-panel="latest">
        <div class="eyebrow">最新の動画</div>
        <a class="lv" href={youtubeUrl(latestVideo.video_id)} target="_blank" rel="noopener">
          <Thumb video={latestVideo} priority />
          <div class="bd">
            <div class="sr"><i class="sw outline"></i>{latestNames}{latestSeries && ` ・ ${latestSeries.name}`}</div>
            <div class="t"><Title title={latestVideo.title} /></div>
            <div class="d">{ymd(latestVideo.published_at)} 公開</div>
            <span class="more">YouTube で見る →</span>
          </div>
        </a>
      </div>

      {visitedIsos.map((iso) => {
        const vs = videosByCountry(iso);
        const s = lastStopIn(iso);
        const ss = seriesOfCountry(iso);
        return (
          <div data-panel={iso} hidden>
            <button type="button" class="back" data-latest>← 最新の動画に戻る</button>
            <div class="eyebrow">{ss.map((x) => x.name).join(' / ')}</div>
            <h3><Flag iso={iso} />{countryName(iso)}</h3>
            <div class="meta">
              {s && <div>訪問時期 <b>{ym(s.arrived)}</b></div>}
              {s && <div>主な滞在地 <b>{[...new Set(vs.flatMap((v) => v.cities))].slice(0, 3).join('・') || s.city}</b></div>}
              <div>動画 <b>{vs.length}本</b></div>
            </div>
            <ul class="vlist">{vs.map((v) => <VideoItem video={v} />)}</ul>
            {ss.map((x) => <a class="serieslink" href={seriesUrl(x.id, iso)}>{x.name}のルートと全動画 <span>→</span></a>)}
          </div>
        );
      })}

      {/* 日本は国内の動画を全部並べず、日本国内編のシリーズへのリンクを出す */}
      <div data-panel={JAPAN} data-count={japanVideoCount} hidden>
        <button type="button" class="back" data-latest>← 最新の動画に戻る</button>
        <div class="eyebrow">日本国内編</div>
        <h3><Flag iso={JAPAN} />日本</h3>
        <div class="meta">
          <div>シリーズ <b>{japanSeries.length}</b></div>
          <div>動画 <b>{japanVideoCount}本</b></div>
        </div>
        {japanSeries.length
          ? japanSeries.map((x) => <a class="serieslink" href={seriesUrl(x.id)}>{x.name}（{seriesSummary(x).videoCount}本） <span>→</span></a>)
          : <p class="empty">日本国内編の動画はまだ取り込んでいません。</p>}
      </div>

      <div data-panel="none" hidden>
        <button type="button" class="back" data-latest>← 最新の動画に戻る</button>
        <div class="eyebrow">COUNTRY</div>
        <h3 data-name></h3>
        <span class="status">まだの国</span>
        <p class="empty">この国の動画はまだありません。</p>
      </div>
    </aside>
    <!-- Instagram プロフィールの公式埋め込み（PC は地図の右、最新の動画の下）。直近の投稿が Instagram 側で自動的に更新される -->
    <div class="igwrap">
      <blockquote class="instagram-media" data-instgrm-permalink={site.instagram_url} data-instgrm-version="14">
        <a href={site.instagram_url} target="_blank" rel="noopener">Instagram で @{site.instagram_account} を見る</a>
      </blockquote>
      {/* 埋め込みは重い（CSS・画像・JS で 1MB 超）ので、ページの読み込みが終わって手が空いてから読み込む */}
      <script is:inline>
        addEventListener('load', () => {
          const go = () => {
            const s = document.createElement('script');
            s.src = 'https://www.instagram.com/embed.js';
            s.async = true;
            document.body.appendChild(s);
          };
          'requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 3000 }) : setTimeout(go, 1500);
          // 埋め込みの iframe にタイトルを付ける（アクセシビリティ）
          new MutationObserver((_, ob) => {
            const f = document.querySelector('.igwrap iframe');
            if (f) {
              f.title = 'Instagram @shigehiroyama';
              ob.disconnect();
            }
          }).observe(document.querySelector('.igwrap'), { childList: true, subtree: true });
        });
      </script>
    </div>
    </div>
  </div>


  <section class="sec">
    {/* 「旅のシリーズ」と「ワールドカップ編」をタブで切り替える */}
    <div class="tabs" role="tablist" aria-label="シリーズの種類">
      <button type="button" role="tab" id="tab-travel" aria-controls="tp-travel" aria-selected="true">旅のシリーズ</button>
      {worldcupSeries.length > 0 && <button type="button" role="tab" id="tab-worldcup" aria-controls="tp-worldcup" aria-selected="false" tabindex="-1">ワールドカップ編 🏆</button>}
      {japanSeries.length > 0 && <button type="button" role="tab" id="tab-japan" aria-controls="tp-japan" aria-selected="false" tabindex="-1">日本国内編</button>}
    </div>
    {[
      { key: 'travel', list: travelSeries },
      { key: 'worldcup', list: worldcupSeries },
      { key: 'japan', list: japanSeries },
    ].filter((g) => g.list.length).map((g) => (
      <div class="series" role="tabpanel" id={`tp-${g.key}`} aria-labelledby={`tab-${g.key}`} hidden={g.key !== 'travel'}>
        {g.list.slice().reverse().map((se) => {
          const sm = seriesSummary(se);
          const season = seasonOf(se.id);
          return (
            <a class="scard" href={seriesUrl(se.id)}>
              <MiniMap seriesId={se.id} />
              <div class="bd">
                <div class="nm"><i class="sdot" style={`background:${seriesColor(se.id)}`}></i>{se.name}{season && <span class="season">シーズン{season}</span>}{!se.ended && <i class="live">旅の途中</i>}<span class="arr">→</span></div>
                <div class="pd">{seriesPeriod(se)} ・ {se.group === 'japan' ? `${sm.stops.length}か所` : `${sm.countryCount}か国`} ・ 動画{sm.videoCount}本</div>
                <div class="cs">{(se.group === 'japan' ? sm.stops.map((x) => x.city ?? '').filter((c, i, a) => c && c !== a[i - 1]) : sm.countryNames).join(' → ')}</div>
              </div>
            </a>
          );
        })}
      </div>
    ))}
  </section>
  <section class="sec">
    <div class="sec-h"><h2>しげ旅の訪問国リスト</h2><span class="sub">動画がある国・地域を、初めて訪れた順に（{visitedList.length}か所）</span></div>
    <ol class="countries">
      {visitedList.map((c) => (
        <li>
          {c.series[0] ? <a href={seriesUrl(c.series.at(-1)!.id, c.iso)}><Flag iso={c.iso} />{c.name}</a> : <span><Flag iso={c.iso} />{c.name}</span>}
          <small>{ym(c.since)}{!c.isCountry && '・地域'}</small>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  import { initMap, isNarrow, type PickDetail } from '../scripts/map';
  const card = document.getElementById('homemap')!;
  const panel = document.getElementById('panel')!;
  const map = initMap(card);
  const tips: Record<string, string> = JSON.parse(card.querySelector('[data-tips]')?.textContent ?? '{}');

  function show(key: string) {
    panel.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
  }
  card.addEventListener('map:pick', (e) => {
    const { id } = (e as CustomEvent<PickDetail>).detail;
    map.select(id);
    if (panel.querySelector(`[data-panel="${CSS.escape(id)}"]`)) show(id);
    else {
      panel.querySelector('[data-panel="none"] [data-name]')!.textContent = (tips[id] ?? id).replace(/・まだの国$/, '');
      show('none');
    }
    // スマホでは続けて国をタップできるよう、自動でスクロールせず地図の下端に案内を出す
    if (isNarrow()) {
      const p = panel.querySelector<HTMLElement>(`[data-panel="${CSS.escape(id)}"]`);
      const name = p?.querySelector('h3')?.textContent ?? panel.querySelector('[data-panel="none"] [data-name]')!.textContent;
      const n = Number(p?.dataset.count ?? p?.querySelectorAll('.vlist > li').length ?? 0);
      chip.textContent = n ? `${name}の動画 ${n}本 ↓` : `${name}：まだ動画はありません`;
      chip.disabled = !n;
      chip.hidden = false;
    }
  });
  const chip = card.querySelector<HTMLButtonElement>('.pickchip')!;
  chip.addEventListener('click', () => {
    panel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  });
  // シリーズのタブ
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')];
  function selectTab(t: HTMLButtonElement) {
    for (const x of tabs) {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    }
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => selectTab(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      selectTab(n);
      n.focus();
    });
  });
  panel.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-latest]')) {
      map.select(null);
      show('latest');
      chip.hidden = true;
    }
  });
</script>
