---
import 'flag-icons/css/flag-icons.min.css';
import '../styles/global.css';
import { visitedCountryCount, countriesWithVideos, officialTally, RECOGNIZED, allSeries, seriesColor, site } from '../lib/data';
interface Props {
  /** ページの <title>（サイト名は後ろに付ける）。無ければホームのタイトル */
  title?: string;
  description: string;
  /** 構造化データ（JSON-LD） */
  jsonLd?: object[];
  /** ホームではロゴを h1 にする */
  home?: boolean;
}
const { title, description, jsonLd = [], home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const SITE_NAME = 'しげ旅ルートマップ';
const pageTitle = title ? `${title}｜${SITE_NAME}` : `${SITE_NAME}｜しげ旅のルート・訪問国リスト・全動画リスト（非公式ファンサイト）`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base.replace(/\/$/, '')}/og.png`, Astro.site).href;
const Logo = home ? 'h1' : 'div';
// 行った国は「最初に行ったシリーズ」の色で塗る
// 詳細度は (0,2,0)：:where(.c.v) より強く、シリーズページの .focus .c.v（0,3,0）より弱い
const seriesCss = allSeries.map((x) => `:where(.c).v.s-${x.id}{fill:${seriesColor(x.id)}}`).join('');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="しげ旅ルートマップ：しげ旅のルートと訪問国を塗った世界地図" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <style is:inline set:html={seriesCss}></style>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)}></script>)}
    <meta name="theme-color" content="#F8F9FA" />
    <link rel="icon" href={`${base.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9K44ZCRMGB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9K44ZCRMGB');
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <radialGradient id="auraG"><stop offset="0" stop-color="#FF4F8B" stop-opacity=".9"></stop><stop offset=".55" stop-color="#7B5CFF" stop-opacity=".35"></stop><stop offset="1" stop-color="#7B5CFF" stop-opacity="0"></stop></radialGradient>
        <linearGradient id="ringG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFD34D"></stop><stop offset=".5" stop-color="#FF4F8B"></stop><stop offset="1" stop-color="#7B5CFF"></stop></linearGradient>
        <linearGradient id="coreG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFD34D"></stop><stop offset="1" stop-color="#FF4F8B"></stop></linearGradient>
      </defs>
    </svg>
    <div class="wrap">
      <header class="a-head">
        <Logo class="logo-wrap"><a class="logo" href={base}>しげ旅<b>ルートマップ</b></a></Logo>
        <span class="pill">非公式ファンサイト</span>
        <div class="count" title={officialTally ? `最新の動画の概要欄に書かれた「しげ旅通算${officialTally}/${RECOGNIZED.size}ヶ国」` : `日本を除く${RECOGNIZED.size}か国のうち、動画が公開されている国の数`}>
          <div class="count-n"><b>{visitedCountryCount}</b><span class="of">/{RECOGNIZED.size}</span>か国 訪問</div>
          <a class="count-src" href={site.youtube_channel_url} target="_blank" rel="noopener">
            <svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" rx="4" fill="#FF0000"></rect><path d="M8 4 L13.5 7 L8 10Z" fill="#fff"></path></svg>YouTube の動画ベース
          </a>
        </div>
      </header>
      <main><slot /></main>
      <footer class="a-foot">
        <p>本サイトは「しげ旅」の非公式ファンサイトです。しげさんの位置は公開済みの投稿から推定した国レベルの情報で、実際の所在とは異なる場合があります。</p>
        <p>訪問国の数は、最新の動画の概要欄に書かれた「しげ旅通算○/195ヶ国」です（日本が国家として承認している国から日本を除いた195か国が基準）。地図で色が付いているのは動画が公開されている国で（{countriesWithVideos}か国）、チャンネル開設前の旅行で訪れた国は含みません。台湾・香港・グリーンランドなどの地域は、地図には色を付けますが数には含めません。日本が承認していない国・地域（北朝鮮など）は濃いグレーで表示しています。</p>
        <p>アクセス解析のため Google アナリティクスを使用しています（Cookie で匿名のアクセス情報を収集します）。</p>
      </footer>
    </div>
    <script>
      // スマホ（タッチ操作の端末）では YouTube のリンクを同じタブで開く。
      // 新しいタブ（target="_blank"）だと iOS Safari でユニバーサルリンクが効かず、YouTube アプリが開かないため。
      // シリーズページの吹き出しは <template> から複製するので、その中身も書き換える
      if (matchMedia('(pointer: coarse)').matches) {
        const roots: ParentNode[] = [document, ...[...document.querySelectorAll('template')].map((t) => t.content)];
        for (const root of roots) root.querySelectorAll('a[href^="https://www.youtube.com/"]').forEach((a) => a.removeAttribute('target'));
      }
    </script>
  </body>
</html>
