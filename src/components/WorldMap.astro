---
// 世界地図。国の塗り分け・ルート・アイコンはビルド時に SVG を出力し、ズーム・ドラッグ・クリックは src/scripts/map.ts が担当する
import { COUNTRY_SHAPES, SMALL, W, H, arc, unwrap, type Box, type Pt } from '../lib/geo';
import {
  visited, latestCountries, isCountry, connected, firstSeriesOf, UNRECOGNIZED_STATES, currentPos, location, countryName, lastStopIn, getSeries, ym,
  allSeries, seriesColor, countriesOfSeries, type RouteStop,
} from '../lib/data';
import Marker from './Marker.astro';

interface Props {
  id: string;
  route: RouteStop[];
  /** 訪問順の番号を出す（シリーズページ） */
  numbered?: boolean;
  /** ルートの表示/非表示ボタンのラベル。無ければボタンを出さない */
  routeButton?: string;
  /** しげさんアイコンを出す（ホームのみ） */
  marker?: boolean;
  /** 初期表示の範囲。無ければ全体 */
  fit?: Box;
  /** 760px 以下での初期表示の範囲 */
  fitNarrow?: Box;
  /** シリーズページ：このシリーズの国だけシリーズの色で塗り、ほかのシリーズで行った国は薄くする */
  focusSeries?: string;
}
const { id, route: rawRoute, numbered = false, routeButton, marker = false, fit, fitNarrow, focusSeries } = Astro.props;
const focusIsos = focusSeries ? countriesOfSeries(focusSeries) : new Set<string>();
// 地図は左右に複製してあり、横に何周でも回せる（src/scripts/map.ts）。
// シリーズのルートが日付変更線をまたぐ（オセアニア編など）ときは、ルートを1か所にまとめた座標で描く
const route = numbered ? unwrap(rawRoute) : rawRoute;

// 小さな国（島国など）は形に加えて丸い点を重ね、世界全体の表示でもタップできるようにする。
// 地図データに形が無い国（ツバルなど）は、滞在地の座標に点だけ置く
const shapeIds = new Set(COUNTRY_SHAPES.map((c) => c.id));
const dots: { id: string; at: Pt; size: number }[] = [
  // 点は国（日本が承認している国）と行った地域だけ。行っていない小さな属領などには付けない
  ...COUNTRY_SHAPES.filter((c) => c.size < SMALL && (isCountry(c.id) || visited.has(c.id))).map((c) => ({ id: c.id, at: c.center, size: c.size })),
  ...[...visited].filter((iso) => !shapeIds.has(iso)).flatMap((iso) => {
    const s = lastStopIn(iso);
    return s ? [{ id: iso, at: { x: s.x, y: s.y }, size: 0 }] : [];
  }),
];
const tips: Record<string, string> = {};
for (const c of [...COUNTRY_SHAPES, ...dots]) {
  const name = countryName(c.id);
  const s = visited.has(c.id) ? lastStopIn(c.id) : undefined;
  const extra = isCountry(c.id) ? '' : '・国数に含まない地域';
  tips[c.id] = visited.has(c.id)
    ? `${name}（${s ? `${ym(s.arrived)}・${getSeries(s.series_id).name}` : '動画あり'}${latestCountries.has(c.id) ? '・最新動画' : ''}${extra}）`
    : UNRECOGNIZED_STATES.has(c.id)
      ? `${name}・日本が承認していない国・地域`
      : `${name}・まだの国`;
}
const cls = (cid: string) =>
  [
    'c',
    visited.has(cid) && 'v',
    visited.has(cid) && firstSeriesOf(cid) && `s-${firstSeriesOf(cid)}`,
    focusIsos.has(cid) && 'in',
    latestCountries.has(cid) && 'lat',
    !visited.has(cid) && UNRECOGNIZED_STATES.has(cid) && 'u',
  ]
    .filter(Boolean)
    .join(' ');
const box = (b?: Box) => (b ? [b.x, b.y, b.w, b.h].map((n) => n.toFixed(1)).join(',') : undefined);
const asOf = new Date(location.as_of).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
const markerTitle = `しげさん（推定）：${countryName(location.iso_n3)}｜根拠：${location.source === 'manual' ? '管理者による設定' : 'Instagram の投稿'}（${asOf} 時点）`;
---
<div
  class:list={['mapcard', focusSeries && 'focus']}
  style={focusSeries ? `--focus:${seriesColor(focusSeries)}` : undefined}
  id={id}
  data-map
  data-fit={box(fit)}
  data-fit-narrow={box(fitNarrow)}
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="世界地図">
    <rect x="-3000" y="-3000" width="7000" height="7000" fill="transparent"></rect>
    <g class="gW" id={`${id}-world`}>
    <g class="gC">
      {COUNTRY_SHAPES.map((c) => <path class={cls(c.id)} data-id={c.id} d={c.d}></path>)}
      {dots.map((d) => <circle class={`${cls(d.id)} dot`} data-id={d.id} data-size={d.size.toFixed(2)} cx={d.at.x} cy={d.at.y} r="1.5"></circle>)}
    </g>
    <g class="gR">
      {route.slice(1).map((s, i) => connected(route[i], s) && <path class="rt" d={arc(route[i], s)}></path>)}
      {route.map((s) => (
        <g class="st" data-sx={s.x} data-sy={s.y} transform={`translate(${s.x},${s.y})`}>
          <circle r={numbered ? 5 : 3}></circle>
          {numbered && <text>{s.seq}</text>}
        </g>
      ))}
    </g>
    {marker && currentPos && (
      <g class="gM">
        <g class="legend-mk" data-sx={currentPos.x} data-sy={currentPos.y} transform={`translate(${currentPos.x},${currentPos.y})`}>
          <Marker /><title>{markerTitle}</title>
        </g>
      </g>
    )}
    </g>
    {[W, -W].map((dx) => <use class="gCopy" href={`#${id}-world`} x={dx} data-dx={dx}></use>)}
  </svg>
  <div class="mapctl">
    <button type="button" data-z="in" aria-label="ズームイン">＋</button>
    <button type="button" data-z="out" aria-label="ズームアウト">−</button>
    <button type="button" data-z="fit" aria-label="全体を表示" title="全体を表示">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <div class="maplegend">
    {focusSeries ? (
      <>
        <span><i class="sw" style={`background:${seriesColor(focusSeries)}`}></i>{getSeries(focusSeries).name}の国</span>
        <span><i class="sw" style="background:var(--visited-dim)"></i>ほかのシリーズで行った国</span>
      </>
    ) : (
      <>
        <span class="lg-h">旅のシリーズ</span>
        {allSeries.map((x) => <span><i class="sw" style={`background:${seriesColor(x.id)}`}></i>{x.name.replace(/編$/, '')}</span>)}
      </>
    )}
    <span><i class="sw outline"></i>最新動画の国</span>
    <span><i class="sw" style="background:var(--land)"></i>まだの国</span>
    {marker && (
      <span><svg class="mk-ico" viewBox="-12 -12 24 24" aria-hidden="true"><g class="legend-mk"><circle class="ring" r="9"></circle><circle class="core" r="5"></circle></g></svg>しげさん（推定）</span>
    )}
  </div>
  {routeButton && <button type="button" class="routebtn" aria-pressed="true">{routeButton}</button>}
  <div class="tip" hidden></div>
  <slot />
  <script type="application/json" data-tips set:html={JSON.stringify(tips)}></script>
</div>
