---
// シリーズカード用の小さな地図。ビルド時に作った SVG 画像（src/pages/minimaps）を遅延読み込みする
interface Props { seriesId: string }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<img class="mini" src={`${base}/minimaps/${Astro.props.seriesId}.svg`} alt="" width="400" height="200" loading="lazy" decoding="async" />
