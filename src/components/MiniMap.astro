---
// シリーズカード用の小さな地図。表示範囲にかかる国だけ出力して HTML を軽くする
import { COUNTRY_SHAPES, W as MAP_W, arc, fitBox, intersects, unwrap } from '../lib/geo';
import { visited, UNRECOGNIZED_STATES, connected, firstSeriesOf, countriesOfSeries, seriesColor, getSeries, JAPAN, type RouteStop } from '../lib/data';
interface Props { stops: RouteStop[]; seriesId: string }
const st = unwrap(Astro.props.stops);
// このシリーズの国だけシリーズの色で塗る（ほかのシリーズで行った国は薄く）
const inSeries = countriesOfSeries(Astro.props.seriesId);
// 日本国内編は旅の順序に意味が無いので、ルートの線は引かず点だけにする
const noRoute = getSeries(Astro.props.seriesId).group === 'japan';
const b = fitBox(st, 0.3, 4);
const asp = 8 / 16;
const w = Math.max(b.w, b.h / asp), h = w * asp;
const view = { x: b.x + b.w / 2 - w / 2, y: b.y + b.h / 2 - h / 2, w, h };
// 日付変更線をまたぐ範囲では、国を左右にずらしたコピーも描く
const shapes = [0, MAP_W, -MAP_W].flatMap((dx) =>
  COUNTRY_SHAPES.filter((c) => intersects({ ...c.bounds, x: c.bounds.x + dx }, view)).map((c) => ({ ...c, dx })),
);
---
<svg class="mini focus" style={`--focus:${seriesColor(Astro.props.seriesId)}`} viewBox={`${view.x.toFixed(1)} ${view.y.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {shapes.map((c) => c.id === JAPAN ? <use href="#jp-fine" class="c jp" transform={c.dx ? `translate(${c.dx},0)` : undefined}></use> : <path class={visited.has(c.id) ? `c v s-${firstSeriesOf(c.id) ?? 'none'}${inSeries.has(c.id) ? ' in' : ''}` : UNRECOGNIZED_STATES.has(c.id) ? 'c u' : 'c'} d={c.d} transform={c.dx ? `translate(${c.dx},0)` : undefined}></path>)}
  {!noRoute && st.slice(1).map((s, i) => connected(st[i], s) && <path class="rt" style={`stroke-width:${(w / 400).toFixed(2)}`} d={arc(st[i], s)}></path>)}
  {st.map((s) => <circle cx={s.x} cy={s.y} r={(w / 180).toFixed(2)} fill="var(--surface)" stroke="var(--route)" stroke-width={(w / 600).toFixed(2)}></circle>)}
</svg>
