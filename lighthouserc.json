{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "4321",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/series/asia/",
        "http://127.0.0.1:4321/series/japan-hokkaido/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-report" }
  }
}
